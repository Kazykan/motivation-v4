{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_INTERNAL_URL"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "django"
    }
  },
  "crons": [
    { "path": "/api/v1/cron/weekly/", "schedule": "0 18 * * 0" },
    { "path": "/api/v1/cron/daily/", "schedule": "0 19 * * *" }
  ],
  "rewrites": [
    { "source": "/admin/(.*)", "destination": { "service": "backend" } },
    { "source": "/static/(.*)", "destination": { "service": "backend" } },
    { "source": "/api/auth/(.*)", "destination": { "service": "frontend" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
