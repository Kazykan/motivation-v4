<file path="frontend/src/app/tg/page.tsx">
"use client"

import { useEffect, useState } from "react"
import { useRouter } from "next/navigation"
import { authApi, MeResponse } from "@/services/authApi"
import { OnboardingFlow } from "@/components/auth/OnboardingFlow"

type Phase = "init" | "checking" | "no-auth" | "loading" | "ready"| "onboarding" | "error"

/**
 * Отдельная точка входа для Telegram Mini App (URL указывается в BotFather).
 *
 * Здесь ЕДИНСТВЕННОЕ место, где допустимо дождаться загрузки Telegram SDK
 * и проверить initData. Все браузерные страницы (/) этой проверки не делают.
 */
export default function TelegramEntryPage() {
  const router = useRouter()
  const [phase, setPhase] = useState<Phase>("init")
  const [me, setMe] = useState<MeResponse | null>(null)
  const [error, setError] = useState<string | null>(null)

  const loadMe = async () => {
    setPhase("loading")
    try {
      const data = await authApi.me()
      setMe(data)
      if (data.onboarded) {
        setPhase("ready")
        router.replace(data.role === "PARENT" ? "/parent/tasks" : "/child/tasks")
      } else {
        setPhase("onboarding")
      }
    } catch (e: any) {
      const status = e?.response?.status
      if (status === 401 || status === 403) {
        // initData невалиден или пользователь неизвестен — в обычный вход.
        router.replace("/")
        return
      }
      setError(e?.response?.data?.error ?? e?.response?.data?.detail ?? "Ошибка авторизации")
      setPhase("error")
    }
  }

  useEffect(() => {
    let cancelled = false
    let attempts = 0

    const tryInit = () => {
      if (cancelled) return
      const tg = (window as any).Telegram?.WebApp

      if (tg) {
        try {
          tg.ready()
          tg.expand()
        } catch {
          // ignore
        }
      }

      const initData: string | undefined = tg?.initData
      if (initData && initData.length > 0) {
        void loadMe()
        return
      }

      // Дать SDK до ~1.5 секунды (15 * 100ms) на появление initData.
      if (attempts++ < 15) {
        setTimeout(tryInit, 100)
        return
      }

      // Не Telegram-контекст (или старый клиент) — обычный вход.
      router.replace("/")
    }

    tryInit()
    return () => {
      cancelled = true
    }
  }, [])

  if (phase === "onboarding" && me) {
    return <OnboardingFlow onDone={loadMe} />
  }

  if (phase === "error") {
    return (
      <div className="flex min-h-[80vh] flex-col items-center justify-center gap-3 px-6 text-center">
        <p className="text-sm text-finance-negative">{error}</p>
      </div>
    )
  }

  return (
    <div className="flex min-h-[80vh] items-center justify-center text-sm text-text-muted">
      Загрузка Telegram Mini App...
    </div>
  )
}
</file>

<file path="frontend/src/components/auth/InviteCodeDialog.tsx">
"use client"

import { useState } from "react"
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog"
import { Button } from "@/components/ui/button"
import { Copy, Check } from "lucide-react"
import { InviteCodeDialogProps } from "@/types/props"

export function InviteCodeDialog({
  open,
  code,
  expiresAt,
  onOpenChange,
  onGenerateNew,
}: InviteCodeDialogProps) {
  const [copied, setCopied] = useState(false)
  const [generating, setGenerating] = useState(false)

  const copyCode = () => {
    navigator.clipboard.writeText(code)
    setCopied(true)
    setTimeout(() => setCopied(false), 2000)
  }

  const handleGenerate = async () => {
    if (!onGenerateNew) return
    setGenerating(true)
    try {
      await onGenerateNew()
    } finally {
      setGenerating(false)
    }
  }

  const expiresLabel = expiresAt
    ? new Date(expiresAt).toLocaleString("ru-RU", {
        day: "numeric",
        month: "long",
        hour: "2-digit",
        minute: "2-digit",
      })
    : null

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-md">
        <DialogHeader>
          <DialogTitle>Код приглашения</DialogTitle>
        </DialogHeader>
        <div className="flex flex-col gap-4 py-4">
          <p className="text-xs text-brand-muted">Передайте код ребёнку или второму родителю.</p>

          {code ? (
            <div className="flex items-center justify-center gap-2 rounded-xl bg-brand-dark p-4 text-white">
              {code.split("").map((digit, idx) => (
                <span key={idx} className="text-2xl font-bold tracking-widest text-brand-primary">
                  {digit}
                </span>
              ))}
              <Button
                variant="ghost"
                size="icon"
                className="ml-2 text-white hover:text-brand-primary"
                onClick={copyCode}
              >
                {copied ? (
                  <Check className="h-5 w-5 text-brand-success" />
                ) : (
                  <Copy className="h-5 w-5" />
                )}
              </Button>
            </div>
          ) : (
            <div className="rounded-xl bg-brand-surface-alt p-4 text-center text-xs text-brand-muted">
              Код пока не создан
            </div>
          )}

          {expiresLabel && (
            <p className="text-center text-[11px] text-brand-muted">Действует до {expiresLabel}</p>
          )}
        </div>

        {onGenerateNew && (
          <DialogFooter>
            <Button
              onClick={handleGenerate}
              disabled={generating}
              className="w-full bg-brand-primary text-brand-dark hover:bg-brand-primary-hover"
            >
              {generating ? "Генерируем..." : "Сгенерировать новый"}
            </Button>
          </DialogFooter>
        )}
      </DialogContent>
    </Dialog>
  )
}
</file>

<file path="frontend/src/components/auth/OnboardingFlow.tsx">
"use client"

import { useState } from "react"
import { RoleStep } from "./RoleStep"
import { ParentStep } from "./ParentStep"
import { ChildStep } from "./ChildStep"
import { OnboardingSlides } from "@/components/onboarding/OnboardingSlides"
import { ONBOARDING_STORAGE_KEY } from "@/lib/onboardingContent"
import { OnboardingFlowProps, OnboardingStep } from "@/types/props"

function getInitialStep(): OnboardingStep {
  if (typeof window === "undefined") return "role"
  return localStorage.getItem(ONBOARDING_STORAGE_KEY) ? "role" : "slides"
}

export function OnboardingFlow({ onDone }: OnboardingFlowProps) {
  const [step, setStep] = useState<OnboardingStep>(getInitialStep)

  if (step === "slides") {
    return (
      <OnboardingSlides
        onDone={() => {
          localStorage.setItem(ONBOARDING_STORAGE_KEY, "1")
          setStep("role")
        }}
      />
    )
  }

  if (step === "role") {
    return (
      <RoleStep onSelectParent={() => setStep("parent")} onSelectChild={() => setStep("child")} />
    )
  }

  if (step === "parent") {
    return <ParentStep onBack={() => setStep("role")} onCreated={onDone} onJoined={onDone} />
  }

  return <ChildStep onBack={() => setStep("role")} onJoined={onDone} />
}
</file>

