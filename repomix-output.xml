"use client"

import { useEffect, useState } from "react"
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog"
import { Button } from "@/components/ui/button"
import { Input } from "@/components/ui/input"
import { Switch } from "@/components/ui/switch"
import { cn } from "@/lib/utils"
import { TaskFormSheetProps } from "@/types/props"
import { parentApi } from "@/services/parentApi"

const DAYS_OF_WEEK = [
  { id: 1, label: "Пн" },
  { id: 2, label: "Вт" },
  { id: 3, label: "Ср" },
  { id: 4, label: "Чт" },
  { id: 5, label: "Пт" },
  { id: 6, label: "Сб" },
  { id: 7, label: "Вс" },
]

const DAY_LABELS_SHORT: Record<number, string> = {
  1: "Пн",
  2: "Вт",
  3: "Ср",
  4: "Чт",
  5: "Пт",
  6: "Сб",
  7: "Вс",
}

export function TaskFormSheet({
  isOpen,
  onClose,
  taskToEdit,
  childrenList,
  onSubmit,
}: TaskFormSheetProps) {
  const [title, setTitle] = useState("")
  const [description, setDescription] = useState("")
  const [price, setPrice] = useState("")
  const [childId, setChildId] = useState<string>("")
  const [scheduleType, setScheduleType] = useState<"FIXED" | "FLEXIBLE">("FIXED")
  const [selectedDays, setSelectedDays] = useState<number[]>([1, 2, 3, 4, 5])
  const [count, setCount] = useState<number>(5)
  const [isActive, setIsActive] = useState<boolean>(true)
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState<string | null>(null)

  useEffect(() => {
    if (taskToEdit) {
      setTitle(taskToEdit.title || "")
      setDescription(taskToEdit.description || "")
      setPrice(String(taskToEdit.weekly_price || taskToEdit.price_per_run || ""))
      setChildId(
        taskToEdit.child_id
          ? String(taskToEdit.child_id)
          : (taskToEdit as any).child
            ? String((taskToEdit as any).child)
            : "",
      )
      setScheduleType(taskToEdit.schedule_type === "FLEXIBLE" ? "FLEXIBLE" : "FIXED")

      const days = taskToEdit.target_days || (taskToEdit as any).days || [1, 2, 3, 4, 5]
      setSelectedDays(
        days
          .map((d: any) => (typeof d === "string" ? parseDayString(d) : Number(d)))
          .filter(Boolean),
      )

      setCount(taskToEdit.target_count || (taskToEdit as any).count || 5)
      setIsActive(taskToEdit.is_active ?? true)
    } else {
      setTitle("")
      setDescription("")
      setPrice("")
      setChildId(childrenList[0]?.id ? String(childrenList[0].id) : "")
      setScheduleType("FIXED")
      setSelectedDays([1, 2, 3, 4, 5])
      setCount(5)
      setIsActive(true)
    }
    setError(null)
  }, [taskToEdit, isOpen, childrenList])

  const parseDayString = (dayStr: string): number => {
    const map: Record<string, number> = { mon: 1, tue: 2, wed: 3, thu: 4, fri: 5, sat: 6, sun: 7 }
    return map[dayStr.toLowerCase()] || 1
  }

  const toggleDay = (dayId: number) => {
    setSelectedDays((prev) =>
      prev.includes(dayId) ? prev.filter((d) => d !== dayId) : [...prev, dayId],
    )
  }

  const checkRemovedDaysHaveLogs = async (): Promise<{
    removedDays: number[]
    activeLogsByDate: Array<{ date: string; status: string; earned_amount: string }>
  } | null> => {
    if (!taskToEdit?.id) return null
    if (scheduleType !== "FIXED") return null

    const originalDays: number[] =
      ((taskToEdit as any).target_days || []).map((d: any) =>
        typeof d === "string" ? parseDayString(d) : Number(d),
      ) || []

    const removedDays = originalDays.filter((d) => !selectedDays.includes(d))
    if (removedDays.length === 0) return null

    const childId = taskToEdit.child_id || (taskToEdit as any).child
    if (!childId) return null

    let reviews: any[] = []
    try {
      const data = await parentApi.getWeeklyReview(Number(childId))
      reviews = Array.isArray(data) ? data : []
    } catch (e) {
      console.warn("Не удалось проверить логи перед изменением расписания:", e)
      return null
    }

    const currentTask = reviews.find((r: any) => r.taskId === taskToEdit.id)
    if (!currentTask || !Array.isArray(currentTask.logs)) {
      return { removedDays, activeLogsByDate: [] }
    }

    const activeLogsByDate = currentTask.logs
      .filter((l: any) => l.status !== "PENDING")
      .map((l: any) => ({
        date: l.date as string,
        status: l.status as string,
        earned_amount: String(l.earned_amount ?? "0"),
      }))
      .filter((l: any) => {
        const d = new Date(`${l.date}T12:00:00`)
        const isoWeekday = d.getDay() === 0 ? 7 : d.getDay()
        return removedDays.includes(isoWeekday)
      })

    return { removedDays, activeLogsByDate }
  }

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!childId) {
      setError("Выберите ребенка")
      return
    }

    setLoading(true)
    setError(null)

    try {
      const removalCheck = await checkRemovedDaysHaveLogs()
      if (removalCheck && removalCheck.activeLogsByDate.length > 0) {
        const daysText = removalCheck.removedDays.map((d) => DAY_LABELS_SHORT[d]).join(", ")
        const logsText = removalCheck.activeLogsByDate
          .map((l) => {
            const d = new Date(`${l.date}T12:00:00`)
            const label = d.toLocaleDateString("ru-RU", {
              day: "numeric",
              month: "short",
            })
            return `${label} (${l.status}, ${l.earned_amount} ₽)`
          })
          .join("\n")

        const ok = window.confirm(
          `Вы убираете дни: ${daysText}.\n\n` +
            `На эти дни уже есть отметки о выполнении:\n${logsText}\n\n` +
            `Существующие логи НЕ удаляются и НЕ пересчитываются автоматически — ` +
            `они останутся в отчёте как «вне расписания».\n\n` +
            `Вы уверены, что хотите сохранить изменения?`,
        )

        if (!ok) {
          setLoading(false)
          return
        }
      }

      const payload: any = {
        title,
        description,
        weekly_price: Number(price),
        child: Number(childId),
        schedule_type: scheduleType,
        is_active: isActive,
      }

      if (scheduleType === "FIXED") {
        payload.target_days = selectedDays
        payload.target_count = null
      } else {
        payload.target_count = count
        payload.target_days = []
      }

      if (taskToEdit?.id) {
        payload.id = taskToEdit.id
      }

      await onSubmit(payload)
      onClose()
    } catch (err: any) {
      console.error("Ошибка сохранения задачи:", err)
      setError(err.response?.data?.detail || "Не удалось сохранить задание.")
    } finally {
      setLoading(false)
    }
  }

  return (
    <Dialog open={isOpen} onOpenChange={(open) => !open && onClose()}>
      <DialogContent className="fixed bottom-0 top-auto left-1/2 w-full max-w-md -translate-x-1/2 translate-y-0 overflow-y-auto rounded-t-3xl rounded-b-none border-none bg-app-surface p-5 shadow-2xl sm:max-w-md max-h-[90vh]">
        <DialogHeader className="pb-1 text-left">
          <DialogTitle className="text-base font-bold text-text-main">
            {taskToEdit ? "Редактировать задание" : "Создать задание"}
          </DialogTitle>
        </DialogHeader>

        <form onSubmit={handleSubmit} className="flex flex-col gap-4 py-2">
          <div className="flex flex-col gap-1.5">
            <label className="text-xs font-medium text-text-muted">Ребенок</label>
            <select
              value={childId}
              onChange={(e) => setChildId(e.target.value)}
              required
              className="h-11 rounded-xl border-none bg-app-card px-3 text-sm text-text-main shadow-none outline-none"
            >
              <option value="" disabled>
                Выберите ребенка
              </option>
              {childrenList.map((child) => (
                <option key={child.id} value={child.id}>
                  {child.first_name || child.name || `Ребенок #${child.id}`}
                </option>
              ))}
            </select>
          </div>

          <div className="flex flex-col gap-1.5">
            <label className="text-xs font-medium text-text-muted">Название задачи</label>
            <Input
              placeholder="Например, Уборка комнаты"
              value={title}
              onChange={(e) => setTitle(e.target.value)}
              required
              className="h-11 rounded-xl border-none bg-app-card text-sm shadow-none"
            />
          </div>

          <div className="flex flex-col gap-1.5">
            <label className="text-xs font-medium text-text-muted">Описание</label>
            <Input
              placeholder="Подробное описание..."
              value={description}
              onChange={(e) => setDescription(e.target.value)}
              className="h-11 rounded-xl border-none bg-app-card text-sm shadow-none"
            />
          </div>

          <div className="flex flex-col gap-1.5">
            <label className="text-xs font-medium text-text-muted">Стоимость за неделю (₽)</label>
            <Input
              type="number"
              step="0.01"
              placeholder="900"
              value={price}
              onChange={(e) => setPrice(e.target.value)}
              required
              className="h-11 rounded-xl border-none bg-app-card text-sm shadow-none"
            />
          </div>

          <div className="flex flex-col gap-1.5">
            <label className="text-xs font-medium text-text-muted">Тип расписания</label>
            <div className="flex rounded-xl bg-app-surface p-1">
              <button
                type="button"
                className={cn(
                  "flex-1 rounded-lg py-2 text-xs font-semibold transition-all",
                  scheduleType === "FIXED"
                    ? "bg-brand-action text-brand-action-text shadow-sm"
                    : "text-text-muted",
                )}
                onClick={() => setScheduleType("FIXED")}
              >
                Фиксированное
              </button>
              <button
                type="button"
                className={cn(
                  "flex-1 rounded-lg py-2 text-xs font-semibold transition-all",
                  scheduleType === "FLEXIBLE"
                    ? "bg-brand-action text-brand-action-text shadow-sm"
                    : "text-text-muted",
                )}
                onClick={() => setScheduleType("FLEXIBLE")}
              >
                Гибкое
              </button>
            </div>
          </div>

          {scheduleType === "FIXED" ? (
            <div className="flex flex-col gap-1.5">
              <label className="text-xs font-medium text-text-muted">Дни недели</label>
              <div className="flex justify-between gap-1">
                {DAYS_OF_WEEK.map((day) => {
                  const isSelected = selectedDays.includes(day.id)
                  return (
                    <button
                      key={day.id}
                      type="button"
                      onClick={() => toggleDay(day.id)}
                      className={cn(
                        "flex h-10 w-10 items-center justify-center rounded-full text-xs font-semibold transition-all",
                        isSelected
                          ? "bg-brand-action text-brand-action-text shadow-sm"
                          : "bg-app-card text-text-muted hover:bg-app-surface",
                      )}
                    >
                      {day.label}
                    </button>
                  )
                })}
              </div>
            </div>
          ) : (
            <div className="flex flex-col gap-1.5">
              <label className="text-xs font-medium text-text-muted">Количество выполнений</label>
              <div className="flex h-11 items-center rounded-xl bg-app-card px-3 shadow-none">
                <button
                  type="button"
                  className="h-8 px-2 text-lg font-medium text-text-muted hover:text-text-main disabled:opacity-20"
                  onClick={() => setCount((prev) => Math.max(1, prev - 1))}
                  disabled={count <= 1}
                >
                  –
                </button>
                <div className="flex-1 text-center text-sm font-semibold text-text-main">
                  {count}
                </div>
                <button
                  type="button"
                  className="h-8 px-2 text-lg font-medium text-text-muted hover:text-text-main disabled:opacity-20"
                  onClick={() => setCount((prev) => Math.min(7, prev + 1))}
                  disabled={count >= 7}
                >
                  +
                </button>
              </div>
            </div>
          )}

          <div className="flex items-center justify-between px-1 pt-1">
            <label className="text-xs font-medium text-text-muted">Активно</label>
            <Switch checked={isActive} onCheckedChange={setIsActive} />
          </div>

          {error && <p className="text-xs text-brand-error">{error}</p>}

          <DialogFooter className="pt-2">
            <Button
              type="submit"
              disabled={loading}
              className="h-12 w-full rounded-xl bg-brand-action text-base font-semibold text-brand-action-text shadow-sm hover:bg-brand-action-hover"
            >
              {loading ? "Сохранение..." : "Сохранить"}
            </Button>
          </DialogFooter>
        </form>
      </DialogContent>
    </Dialog>
  )
}
</file>

