"use client"

import { useEffect } from "react"
import { useRouter } from "next/navigation"
import { useMe } from "@/hooks/useMe"

/**
 * Проверяет, что у ребёнка заполнены обязательные поля профиля
 * (birth_date и gender). Если нет — редиректит на /child/profile?require=1.
 *
 * Возвращает { me, ready }: ready=false означает, что идёт проверка
 * или выполняется редирект — контент рендерить нельзя.
 */
export function useRequireProfile() {
  const router = useRouter()
  const { me, ready } = useMe()

  const missing = !!me && (!me.birth_date || !me.gender)

  useEffect(() => {
    if (!ready || !me) return
    if (missing) {
      router.replace("/child/profile?require=1")
    }
  }, [ready, me, missing, router])

  return { me, ready: ready && !missing }
}
</file>

<file path="frontend/src/hooks/useRequireRole.ts">
"use client"

import { useEffect, useState } from "react"
import { useRouter } from "next/navigation"
import { authApi, MeResponse, UserRole } from "@/services/authApi"

/**
 * Проверяет, что пользователь онборджен и имеет нужную роль.
 * При несоответствии — редиректит.
 *
 * Возвращает { me, ready }:
 * - ready=false — ещё идёт проверка, страница не должна показывать контент;
 * - ready=true — проверка пройдена, можно рендерить.
 */
export function useRequireRole(requiredRole: UserRole) {
  const router = useRouter()
  const [me, setMe] = useState<MeResponse | null>(null)
  const [ready, setReady] = useState(false)

  useEffect(() => {
    let cancelled = false

    authApi
      .me()
      .then((data) => {
        if (cancelled) return

        if (!data.onboarded) {
          router.replace("/")
          return
        }

        if (data.role !== requiredRole) {
          router.replace(data.role === "PARENT" ? "/parent/tasks" : "/child/tasks")
          return
        }

        setMe(data)
        setReady(true)
      })
      .catch(() => {
        if (cancelled) return
        router.replace("/")
      })

    return () => {
      cancelled = true
    }
  }, [router, requiredRole])

  return { me, ready }
}
</file>

