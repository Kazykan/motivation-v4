<file path="frontend/src/components/LogHistoryViewer.tsx">
"use client"

import { useQuery } from "@tanstack/react-query"
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar"
import { parentApi } from "@/services/parentApi"
import { UserRound, Clock3 } from "lucide-react"
import { LogHistoryViewerProps, TaskLogHistoryItem } from "@/types/props"

export function LogHistoryViewer({ logId }: LogHistoryViewerProps) {
  const { data: history = [], isLoading } = useQuery<TaskLogHistoryItem[]>({
    queryKey: ["task-log-history", logId],
    queryFn: () => parentApi.getTaskLogHistory(logId),
    enabled: !!logId,
  })

  if (isLoading) {
    return <div className="text-xs text-text-muted">Загрузка истории...</div>
  }

  if (history.length === 0) {
    return <div className="text-xs text-text-muted">Изменений пока нет</div>
  }

  const roleLabel = (role: string | null | undefined) => {
    if (role === "PARENT") return "Родитель"
    if (role === "CHILD") return "Ребёнок"
    return ""
  }

  const lastChange = history[0]

  const formattedDate = lastChange?.changed_at
    ? new Date(lastChange.changed_at).toLocaleString("ru-RU", {
        day: "numeric",
        month: "short",
        hour: "2-digit",
        minute: "2-digit",
      })
    : "Недавно"

  return (
    <div className="space-y-1 border-t border-app-surface pt-2">
      <div className="flex items-center gap-1.5 text-[11px] text-text-muted">
        <Avatar className="h-4 w-4">
          <AvatarImage src={lastChange?.changed_by_avatar ?? undefined} />
          <AvatarFallback className="text-[8px]">
            {(lastChange?.changed_by_name || "?").slice(0, 1)}
          </AvatarFallback>
        </Avatar>
        <span>
          Изменил: {lastChange?.changed_by_name || "—"}
          {lastChange?.changed_by_role ? ` (${roleLabel(lastChange.changed_by_role)})` : ""}
        </span>
      </div>
      <div className="flex items-center gap-1.5 text-[11px] text-text-muted">
        <Clock3 className="h-3 w-3" />
        <span>Когда: {formattedDate}</span>
      </div>
    </div>
  )
}
</file>

<file path="frontend/src/components/LogStatusEditor.tsx">
"use client"

import { useState } from "react"
import { Button } from "@/components/ui/button"
import { Separator } from "@/components/ui/separator"
import { cn } from "@/lib/utils"
import { Check, Clock3, X, Trash2 } from "lucide-react"
import { LogHistoryViewer } from "@/components/LogHistoryViewer"
import { LogStatusValue } from "@/types/props"
import { formatLongDay } from "@/lib/dates"

interface LogStatusEditorProps {
  logId: number
  date: string
  status: LogStatusValue
  weekClosed?: boolean
  onChangeStatus: (logId: number, status: LogStatusValue) => Promise<void>
  onClose: () => void
}

const STATUS_OPTIONS: {
  value: LogStatusValue
  label: string
  icon: typeof Clock3
  activeClass: string
  iconClass: string
}[] = [
  {
    value: "DONE",
    label: "Ожидает",
    icon: Clock3,
    activeClass: "border-brand-warning bg-brand-warning-soft text-brand-warning-strong",
    iconClass: "text-brand-warning",
  },
  {
    value: "APPROVED",
    label: "Подтверждено",
    icon: Check,
    activeClass: "border-brand-success bg-brand-success-soft text-brand-success-strong",
    iconClass: "text-brand-success",
  },
  {
    value: "REJECTED",
    label: "Отклонено",
    icon: X,
    activeClass: "border-brand-error bg-brand-error-soft text-brand-error-strong",
    iconClass: "text-brand-error",
  },
]

export function LogStatusEditor({
  logId,
  date,
  status,
  weekClosed = false,
  onChangeStatus,
  onClose,
}: LogStatusEditorProps) {
  const [saving, setSaving] = useState(false)
  const [error, setError] = useState<string | null>(null)

  const disabled = saving || weekClosed

  const handleStatusChange = async (nextStatus: LogStatusValue) => {
    if (nextStatus === status || disabled) return

    setSaving(true)
    setError(null)

    try {
      await onChangeStatus(logId, nextStatus)
      onClose()
    } catch (err) {
      console.error("Ошибка изменения статуса:", err)
      setError("Не удалось сохранить статус. Попробуйте ещё раз.")
    } finally {
      setSaving(false)
    }
  }

  return (
    <div className="animate-in slide-in-from-bottom-2 space-y-3 rounded-xl border border-app-surface bg-app-card p-3 shadow-sm duration-200">
      <div className="flex items-center justify-between">
        <div>
          <p className="text-sm font-semibold text-text-main">Статус выполнения</p>
          <p className="text-xs text-text-muted">{formatLongDay(date)}</p>
        </div>

        <Button
          type="button"
          variant="ghost"
          size="icon"
          className="h-8 w-8"
          onClick={onClose}
          disabled={saving}
          aria-label="Закрыть редактор"
        >
          <X className="h-4 w-4" />
        </Button>
      </div>

      {weekClosed && (
        <div className="rounded-lg border border-brand-success bg-brand-success-soft p-2 text-[11px] text-brand-success-strong">
          Неделя закрыта и выплачена. Изменять отметки нельзя.
        </div>
      )}

      {status === "CANCELLED" && !weekClosed && (
        <div className="rounded-lg border border-app-surface bg-app-surface p-2 text-[11px] text-text-muted">
          Отметка удалена. Выберите новый статус, чтобы восстановить запись. История изменений
          сохранена.
        </div>
      )}

      <div className="grid grid-cols-3 gap-2">
        {STATUS_OPTIONS.map((option) => {
          const Icon = option.icon
          const isActive = status === option.value

          return (
            <button
              key={option.value}
              type="button"
              disabled={disabled}
              onClick={() => handleStatusChange(option.value)}
              aria-pressed={isActive}
              className={cn(
                "flex min-h-[88px] flex-col items-center justify-center gap-2 rounded-xl border-2 p-2 transition-all",
                "disabled:cursor-not-allowed disabled:opacity-60",
                isActive
                  ? option.activeClass
                  : "border-app-surface bg-app-card text-text-muted hover:bg-app-surface",
              )}
            >
              <Icon className={cn("h-5 w-5", isActive ? option.iconClass : "text-text-muted")} />
              <span className="text-center text-xs font-semibold leading-tight">
                {option.label}
              </span>
              {isActive && <span className="text-[9px] font-medium">Текущий</span>}
            </button>
          )
        })}
      </div>

      {saving && <p className="text-center text-xs text-text-muted">Сохранение...</p>}

      {error && (
        <p role="alert" className="text-xs text-brand-error">
          {error}
        </p>
      )}

      <Separator />

      {logId > 0 && (
        <Button
          type="button"
          variant="outline"
          className="w-full border-brand-error/30 text-brand-error hover:bg-brand-error-soft hover:text-brand-error-strong"
          disabled={disabled || status === "CANCELLED"}
          onClick={() => handleStatusChange("CANCELLED")}
        >
          <Trash2 className="mr-2 h-4 w-4" />
          {status === "CANCELLED" ? "Отметка удалена" : "Удалить отметку"}
        </Button>
      )}

      {logId > 0 ? (
        <LogHistoryViewer logId={logId} />
      ) : (
        <div className="text-xs text-text-muted">Изменений пока нет</div>
      )}
    </div>
  )
}
</file>

